{
  "schema_version": 1,
  "name": "Appointment Booking Routing",
  "description": "Routes booking calls to the standard booking agent and switches to an after-hours booking agent outside service-desk hours.",
  "default_agent": "appointment_booking_agent",
  "routes": [
    {
      "schedule": "after_hours",
      "agent": "after_hours_booking_agent"
    }
  ],
  "schedules": {
    "after_hours": {
      "timezone": "America/New_York",
      "hours": [
        {
          "days": ["mon", "tue", "wed", "thu", "fri"],
          "start": "00:00",
          "end": "08:00"
        },
        {
          "days": ["mon", "tue", "wed", "thu", "fri"],
          "start": "18:00",
          "end": "23:59"
        },
        {
          "days": ["sat", "sun"],
          "start": "00:00",
          "end": "23:59"
        }
      ]
    }
  }
}
