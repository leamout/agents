{
  "schema_version": 1,
  "name": "Appointment Booking Routing",
  "description": "Routes staffed-hours booking calls to the primary booking agent and after-hours calls to the included automated booking agent.",
  "default_agent": "appointment-booking",
  "routes": [
    {
      "schedule": "after_hours",
      "agent": "after-hours"
    }
  ],
  "schedules": {
    "after_hours": {
      "timezone": "America/New_York",
      "hours": [
        {
          "days": ["mon", "tue", "wed", "thu", "fri"],
          "start": "00:00",
          "end": "08:00"
        },
        {
          "days": ["mon", "tue", "wed", "thu", "fri"],
          "start": "18:00",
          "end": "23:59"
        },
        {
          "days": ["sat", "sun"],
          "start": "00:00",
          "end": "23:59"
        }
      ]
    }
  }
}
