{
  "schema_version": 1,
  "name": "Sales Qualifier Routing",
  "description": "Routes staffed-hours sales calls to the primary qualifier and after-hours calls to the included after-hours qualifier.",
  "default_agent": "sales-qualifier",
  "routes": [
    {
      "schedule": "after_hours",
      "agent": "after-hours"
    }
  ],
  "schedules": {
    "after_hours": {
      "timezone": "America/New_York",
      "hours": [
        {
          "days": ["mon", "tue", "wed", "thu", "fri"],
          "start": "00:00",
          "end": "09:00"
        },
        {
          "days": ["mon", "tue", "wed", "thu", "fri"],
          "start": "17:00",
          "end": "23:59"
        },
        {
          "days": ["sat", "sun"],
          "start": "00:00",
          "end": "23:59"
        }
      ]
    }
  }
}
